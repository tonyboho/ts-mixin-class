---
interface Props {
    title        : string
    description? : string
}

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
    />
    <style is:global>
        :root {
            --bg      : #faf8f3;
            --fg      : #23211c;
            --soft    : #57534a;
            --muted   : #8b867a;
            --border  : #e6e1d5;
            --hair    : #d8d2c4;
            --code-bg : #f1eee6;
            --serif   : "Newsreader", Georgia, serif;
            --mono    : "JetBrains Mono", ui-monospace, monospace;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --bg      : #191813;
                --fg      : #ddd8cc;
                --soft    : #b0aa9c;
                --muted   : #7d786c;
                --border  : #2e2c25;
                --hair    : #3a372e;
                --code-bg : #211f19;
            }
        }

        * { box-sizing: border-box }

        html { scroll-behavior: smooth }

        body {
            margin     : 0;
            background : var(--bg);
            color      : var(--fg);
            font       : 400 19px/1.7 var(--serif);
            font-optical-sizing : auto;
            -webkit-font-smoothing : antialiased;
        }

        ::selection { background: var(--hair) }

        .wrap {
            max-width      : 48rem;
            margin-inline  : auto;
            padding-inline : 20px;
        }

        /* ---------- header ---------- */

        header.site { padding-block: 2.6rem 0 }

        header.site nav {
            display         : flex;
            align-items     : baseline;
            justify-content : space-between;
            gap             : 1rem;
            flex-wrap       : wrap;
            padding-bottom  : 1.1rem;
            border-bottom   : 1px solid var(--border);
        }

        header.site .name {
            font-family     : var(--mono);
            font-size       : .85rem;
            font-weight     : 500;
            letter-spacing  : .04em;
            text-decoration : none;
            color           : var(--fg);
        }

        header.site .name .tilde { color: var(--muted) }

        header.site .links {
            display : flex;
            gap     : 1.4rem;
        }

        header.site a.ext {
            font-family     : var(--mono);
            font-size       : .72rem;
            letter-spacing  : .14em;
            text-transform  : uppercase;
            text-decoration : none;
            color           : var(--muted);
            transition      : color .15s ease;
        }

        header.site a.ext:hover { color: var(--fg) }

        main { padding-top: 3rem }

        /* ---------- typography ---------- */

        h1, h2, h3 {
            font-family    : var(--serif);
            font-weight    : 500;
            line-height    : 1.2;
            letter-spacing : -0.015em;
        }

        h1 { font-size: 2.3rem; margin: 0 }
        h2 { font-size: 1.45rem; margin: 2.6rem 0 .8rem }

        a {
            color                     : inherit;
            text-decoration-thickness : 1px;
            text-decoration-color     : var(--hair);
            text-underline-offset     : 4px;
            transition                : text-decoration-color .15s ease;
        }

        a:hover { text-decoration-color: var(--soft) }

        .muted { color: var(--muted) }

        /* ---------- post list ---------- */

        .intro {
            font-style    : italic;
            font-size     : 1.15rem;
            color         : var(--soft);
            margin        : 0 0 2.8rem;
        }

        ul.posts { list-style: none; padding: 0; margin: 0 }

        ul.posts li {
            display       : flex;
            align-items   : baseline;
            gap           : .9rem;
            padding-block : .7rem;
        }

        ul.posts li + li { border-top: 1px solid var(--border) }

        ul.posts a {
            font-size       : 1.18rem;
            text-decoration : none;
        }

        ul.posts a:hover { text-decoration: underline; text-decoration-color: var(--hair) }

        ul.posts .leader {
            flex          : 1;
            min-width     : 2rem;
            border-bottom : 1px dotted var(--hair);
            transform     : translateY(-.35em);
        }

        ul.posts time {
            font-family    : var(--mono);
            font-size      : .72rem;
            letter-spacing : .08em;
            color          : var(--muted);
            white-space    : nowrap;
        }

        /* ---------- article ---------- */

        article.post header.post { margin-bottom: 2.6rem }

        article.post .kicker {
            font-family    : var(--mono);
            font-size      : .72rem;
            letter-spacing : .16em;
            text-transform : uppercase;
            color          : var(--muted);
            margin         : 0 0 1.1rem;
        }

        article.post .lede {
            font-style  : italic;
            font-size   : 1.22rem;
            line-height : 1.55;
            color       : var(--soft);
            margin      : 1.1rem 0 0;
        }

        article.post .ornament {
            border      : 0;
            margin      : 2.2rem auto 0;
            width       : 5rem;
            height      : 1px;
            background  : var(--hair);
        }

        article.post p { margin: 1.25rem 0 }

        article.post .emphasis {
            background : var(--hair);
            padding    : .22em .38em;
            -webkit-box-decoration-break : clone;
            box-decoration-break         : clone;
        }

        article.post blockquote {
            margin       : 1.9rem 0;
            padding      : .05rem 0 .05rem 1.3rem;
            border-left  : 2px solid var(--soft);
            color        : var(--fg);
        }

        /* ---------- diagrams ---------- */

        figure.diagram {
            margin     : 2.4rem auto;
            text-align : center;
        }

        figure.diagram svg { max-width: 100%; height: auto }

        figure.diagram figcaption {
            font-size  : .88rem;
            font-style : italic;
            color      : var(--muted);
            max-width  : 30rem;
            margin     : .9rem auto 0;
            line-height: 1.5;
        }

        /* ---------- code ---------- */

        code {
            font-family : var(--mono);
            font-size   : .78em;
        }

        :not(pre) > code {
            background    : var(--code-bg);
            padding       : .12em .4em;
            border-radius : 4px;
        }

        pre {
            border        : 1px solid var(--border);
            border-radius : 8px;
            padding       : 1.15rem 1.3rem;
            overflow-x    : auto;
            margin        : 1.7rem 0;
            font-size     : .8rem;
            line-height   : 1.65;
        }

        @media (prefers-color-scheme: dark) {
            pre.astro-code,
            pre.astro-code span {
                color            : var(--shiki-dark) !important;
                background-color : var(--shiki-dark-bg) !important;
            }
        }

        /* ---------- footer ---------- */

        footer.site { margin-top: 5.5rem; padding-bottom: 3rem }

        footer.site .rule {
            border        : 0;
            border-top    : 1px solid var(--border);
            margin-bottom : 1.4rem;
        }

        footer.site .inner {
            font-family    : var(--mono);
            font-size      : .72rem;
            letter-spacing : .06em;
            color          : var(--muted);
        }
    </style>
</head>
<body>
    <header class="site">
        <nav class="wrap">
            <a class="name" href={base}><span class="tilde">~/</span>ts-mixin-class<span class="tilde"> · blog</span></a>
            <span class="links">
                <a class="ext" href="https://github.com/tonyboho/ts-mixin-class">GitHub</a>
                <a class="ext" href="https://www.npmjs.com/package/ts-mixin-class">npm</a>
            </span>
        </nav>
    </header>
    <main class="wrap">
        <slot />
    </main>
    <footer class="site">
        <div class="wrap">
            <hr class="rule" />
            <div class="inner">
                ts-mixin-class — practical multiple inheritance for TypeScript classes
            </div>
        </div>
    </footer>
</body>
</html>
